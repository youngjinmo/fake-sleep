{
  "sourceLanguage" : "en",
  "strings" : {
    "fakeSleep.error.batteryBelowCutoff" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery reached the configured cutoff, so the session stopped."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーが設定したしきい値に達したため、セッションを終了しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리가 설정한 기준 이하가 되어 세션을 종료했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池电量达到设定阈值，因此会话已停止。"
          }
        }
      }
    },
    "fakeSleep.error.emergencyEscapeUnavailable" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emergency Escape could not be registered."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急復元用のEscapeを登録できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴급 Escape를 등록할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法注册用于紧急恢复的 Escape。"
          }
        }
      }
    },
    "fakeSleep.error.incompleteOverlayCoverage" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not cover every display."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのディスプレイを覆えませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 디스플레이를 가릴 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法覆盖所有显示器。"
          }
        }
      }
    },
    "fakeSleep.error.lockTimedOut" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac was not locked within 60 seconds, so the session stopped."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60秒以内にMacがロックされなかったため、セッションを終了しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60초 안에 Mac이 잠기지 않아 세션을 종료했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 未在 60 秒内锁定，因此会话已停止。"
          }
        }
      }
    },
    "fakeSleep.error.noRestorePath" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No restore shortcut is available."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元ショートカットを利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원 단축키를 사용할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可用的恢复快捷键。"
          }
        }
      }
    },
    "fakeSleep.error.noScreens" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No displays are available."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
