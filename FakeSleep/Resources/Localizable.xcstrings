{
  "sourceLanguage" : "en",
  "strings" : {
    "fakeSleep.error.emergencyEscapeUnavailable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emergency Escape could not be registered."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴급 Escape를 등록할 수 없습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急復元用のEscapeを登録できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法注册用于紧急恢复的 Escape。"
          }
        }
      }
    },
    "fakeSleep.error.incompleteOverlayCoverage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not cover every display."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 디스플레이를 가릴 수 없습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのディスプレイを覆えませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法覆盖所有显示器。"
          }
        }
      }
    },
    "fakeSleep.error.noRestorePath" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No restore shortcut is available."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원 단축키를 사용할 수 없습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元ショートカットを利用できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可用的恢复快捷键。"
          }
        }
      }
    },
    "fakeSleep.error.noScreens" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No displays are available."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 디스플레이가 없습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能なディスプレイがありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可用的显示器。"
          }
        }
      }
    },
