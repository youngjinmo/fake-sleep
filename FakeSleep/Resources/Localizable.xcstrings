    "landing.darkenScreens" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darken Screens"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイを暗くする"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 어둡게 하기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使屏幕变暗"
          }
        }
      }
    },
    "landing.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A visual blackout for every connected display."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されたすべてのディスプレイを視覚的に暗転させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결된 모든 디스플레이를 시각적으로 어둡게 표시합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让所有已连接的显示器呈现黑屏。"
          }
        }
      }
    },
    "landing.displayLimitation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleep covers your displays with black overlays. It does not change display brightness or power."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleepは黒いオーバーレイでディスプレイを覆います。ディスプレイの明るさや電源は変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleep은 검은색 오버레이로 디스플레이를 가립니다. 디스플레이 밝기나 전원을 변경하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleep 通过黑色覆盖层遮住显示器，不会改变显示器亮度或电源状态。"
          }
        }
      }
    },
    "landing.dontShowAtLaunch" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't show this guide at launch"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時にこのガイドを表示しない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작할 때 이 가이드 표시 안 함"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动时不显示此指南"
          }
        }
      }
    },
