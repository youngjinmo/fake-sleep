    "landing.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A visual blackout for every connected display."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결된 모든 디스플레이를 시각적으로 어둡게 표시합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されたすべてのディスプレイを視覚的に暗転させます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让所有已连接的显示器呈现黑屏。"
          }
        }
      }
    },
    "landing.displayLimitation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleep covers your displays with black overlays. It does not change display brightness or power."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleep은 검은색 오버레이로 디스플레이를 가립니다. 디스플레이 밝기나 전원을 변경하지 않습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleepは黒いオーバーレイでディスプレイを覆います。ディスプレイの明るさや電源は変更しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleep 通过黑色覆盖层遮住显示器，不会改变显示器亮度或电源状态。"
          }
        }
      }
    },
    "landing.darkenScreens" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darken Screens"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 어둡게 하기"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイを暗くする"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使屏幕变暗"
          }
        }
      }
    },
    "landing.dontShowAtLaunch" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't show this guide at launch"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작할 때 이 가이드 표시 안 함"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時にこのガイドを表示しない"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动时不显示此指南"
          }
        }
      }
    },
    "landing.instructions" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to use"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 방법"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleepの使い方"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleep 使用指南"
          }
        }
      }
    },
    "landing.openSettings" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 열기…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定を開く…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开设置…"
          }
        }
      }
    },
    "landing.restoreInstruction" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Esc at any time while Fake Sleep is active to restore your displays."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleep이 활성화된 동안 언제든지 Esc를 누르면 디스플레이를 복원할 수 있습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleepが有効な間は、いつでもEscを押すとディスプレイを復元できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake Sleep 处于活动状态时，随时按下 Esc 即可恢复显示器。"
          }
        }
      }
    },
    "landing.shortcutInstruction" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press %@ anywhere, or use the button below."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@를 어디서든 누르거나 아래 버튼을 사용하세요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこでも%@を押すか、下のボタンを使ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意位置按 %@，或使用下方的按钮。"
          }
        }
      }
    },
    "landing.shortcutNotSet" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No shortcut is set. Open Settings… to choose one, or use the button below."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키가 설정되지 않았습니다. 설정…에서 선택하거나 아래 버튼을 사용하세요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットが設定されていません。「設定…」で選択するか、下のボタンを使ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未设置快捷键。请打开“设置…”进行选择，或使用下方的按钮。"
          }
        }
      }
    },
